{
  "name": "anthology-tech-book-template",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "{{REPOSITORY_GIT_URL}}",
  "author": "{{BOOK_AUTHOR}}",
  "license": "MIT",
  "scripts": {
    "lint": "textlint ./book/manuscripts/",
    "sync": "node scripts/sync-all.mjs",
    "sync:reviews": "node scripts/sync-reviews.mjs",
    "sync:proposals": "node scripts/sync-proposals.mjs",
    "start": "run-s sync build:pdf open",
    "build": "run-s sync build:pdf",
    "build:pdf": "vivliostyle build book/vivliostyle.config.js",
    "build:press": "run-s sync build:press-pdf",
    "build:press-pdf": "vivliostyle build book/vivliostyle.config.press.local.js",
    "open": "open ./book/output/ebook.pdf",
    "clean": "rm -rf ./book/output/",
    "cover": "node ./scripts/InsertCoverImage.js",
    "check": "biome check",
    "check-write": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@vivliostyle/cli": "10.5.0",
    "npm-run-all2": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "textlint": "^15.7.1",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-spacing": "^2.3.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.0",
    "textlint-rule-spellcheck-tech-word": "^5.0.0"
  },
  "packageManager": "yarn@4.12.0"
}
