{
  "name": "anthology-tech-book-templat",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "{{REPOSITORY_GIT_URL}}",
  "author": "{{BOOK_AUTHOR}}",
  "license": "MIT",
  "scripts": {
    "lint": "textlint ./book/manuscripts/",
    "toc": "node scripts/generate-toc.mjs",
    "start": "run-s toc build open",
    "build": "run-s toc build:pdf",
    "build:pdf": "cd ./book/ && vivliostyle build",
    "build:press": "run-s toc build:press-pdf",
    "build:press-pdf": "cd ./book/ && vivliostyle build --config vivliostyle.config.press.local.js",
    "open": "open ./book/output/ebook.pdf",
    "clean": "rm -rf ./book/output/",
    "cover": "node ./scripts/InsertCoverImage.js",
    "check": "biome check",
    "check-write": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.6.1",
    "@vivliostyle/cli": "10.3.0",
    "npm-run-all2": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "textlint": "^15.5.1",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-spacing": "^2.3.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.0",
    "textlint-rule-spellcheck-tech-word": "^5.0.0"
  },
  "packageManager": "yarn@4.12.0"
}
